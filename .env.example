# Copy to .env.local and fill in.

# ── AI Mentor (FREE options — only ONE is needed) ───────────────────────────
# Option A (recommended): Google Gemini — free tier, no card needed.
#   1. Go to https://aistudio.google.com/apikey and sign in with a Google account.
#   2. Click "Create API key", copy the key.
#   3. Paste it below and in Vercel: Project → Settings → Environment Variables.
GEMINI_API_KEY=your_free_gemini_key_here

# Option B: Groq (free tier, very fast). Used only when GEMINI_API_KEY is empty.
#   1. Go to https://console.groq.com/keys and create a free key.
#   2. Paste it below.
# GROQ_API_KEY=your_free_groq_key_here

# ── Database ─────────────────────────────────────────────────────────────────
# Optional: hosted libSQL/Turso DB for production (e.g. libsql://your-db.turso.io).
# Defaults to a local SQLite file at data/bta.db when unset.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your_turso_token

# Registering with this email automatically makes the account a Super Administrator.
# SUPER_ADMIN_EMAIL=you@example.com
